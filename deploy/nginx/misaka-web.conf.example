# 可选：已经用 nginx 的环境用的等价配置（推荐方案仍是 deploy/caddy/）。
# 与 Caddyfile.example 对应的三处 SSE 关键点是：proxy_buffering off、
# gzip off、以及远大于 25s 心跳的 proxy_read_timeout。

server {
    listen 443 ssl;
    http2 on;
    server_name misaka.example.com;

    ssl_certificate     /etc/letsencrypt/live/misaka.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/misaka.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;

        # SSE 关键三行：不缓冲、不压缩、读超时远大于 25s 心跳
        proxy_buffering off;
        gzip off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;

        # 若上游漏了 flush 头，这个也能兜一层（Caddy 方案不需要）
        proxy_set_header X-Accel-Buffering no;
    }
}

# 注意：不要在 server/location 里给 /api/sessions/*/events 加限制请求体/限速模块，
# 长连接会被算进连接数配额，导致"打开第二个页签就卡住"。
